{
  "title": "Notes API",
  "schemaVersion": 39,
  "panels": [
    {"type": "stat", "title": "Uptime probe", "gridPos": {"x":0,"y":0,"w":6,"h":4},
     "targets": [{"expr": "probe_success{job=\"notes-api-probe\"}"}]},
    {"type": "timeseries", "title": "Probe latency (s)", "gridPos": {"x":6,"y":0,"w":18,"h":8},
     "targets": [{"expr": "probe_duration_seconds{job=\"notes-api-probe\"}"}]},
    {"type": "timeseries", "title": "Container CPU (notes app)", "gridPos": {"x":0,"y":8,"w":12,"h":8},
     "targets": [{"expr": "rate(container_cpu_usage_seconds_total{name=~\".*app.*\"}[5m])"}]},
    {"type": "timeseries", "title": "Container memory (notes app)", "gridPos": {"x":12,"y":8,"w":12,"h":8},
     "targets": [{"expr": "container_memory_working_set_bytes{name=~\".*app.*\"}"}]}
  ]
}
